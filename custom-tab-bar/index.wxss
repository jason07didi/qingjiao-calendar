.tabbar {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 108rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFFFF;
  border-top: 1rpx solid #EDF0F4;
  display: flex;
  z-index: 999;
  box-sizing: content-box;
}

.tab-item {
  flex: 1;
  height: 108rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.icon {
  font-size: 38rpx;
  line-height: 1;
  opacity: 0.45;
  transform: translateY(2rpx);
}

.icon.on {
  opacity: 1;
}

.name {
  font-size: 20rpx;
  color: #93A1AF;
  margin-top: 6rpx;
}

.name.on {
  color: #123B5B;
  font-weight: 500;
}
