/**app.wxss**/
page {
  background: #F4F6F8;
  color: #1B2733;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

.page {
  min-height: 100vh;
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(18, 59, 91, 0.05);
}

/* 类型标签 */
.tag {
  display: inline-block;
  font-size: 20rpx;
  line-height: 30rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
  font-weight: 500;
}
.tag-project     { color: #123B5B; background: #E8EEF4; }
.tag-talent      { color: #6B4E9B; background: #EEEAF6; }
.tag-award       { color: #A8791B; background: #F8F2E4; }
.tag-conference  { color: #1D7A5F; background: #E6F2EE; }
.tag-special     { color: #2E6FA8; background: #E7F0F8; }
.tag-competition { color: #B4551F; background: #F8EDE6; }
.tag-standard    { color: #C0392B; background: #FBEAEA; }
.tag-license     { color: #8E44AD; background: #F1E8F7; }
.tag-postdoc     { color: #16A085; background: #E6F4F0; }
.tag-visit       { color: #2980B9; background: #E7F0F8; }
.tag-review      { color: #D35400; background: #FBEDE3; }
.tag-student     { color: #27AE60; background: #E6F4EC; }
.tag-growth      { color: #5FA02C; background: #EDF5E1; }

/* 学科标签 */
.tag-dis {
  display: inline-block;
  font-size: 20rpx;
  line-height: 30rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
  color: #5A6B7B;
  background: #F1F4F7;
}

/* 筛选 chip */
.chips {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 24rpx 8rpx;
  box-sizing: border-box;
}
.chip {
  display: inline-block;
  padding: 10rpx 26rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #5A6B7B;
  background: #FFFFFF;
  border: 1rpx solid #E8ECF1;
}
.chip.on {
  color: #FFFFFF;
  background: #123B5B;
  border-color: #123B5B;
}
.chip.sm {
  font-size: 22rpx;
  padding: 6rpx 20rpx;
}
/* 「更多 ▾」入口：浅蓝底，和主干 chip 区分 */
.chip-more {
  color: #123B5B;
  background: #EAF1F7;
  border-color: #C9D8E6;
  font-weight: 500;
}
/* 折叠出来的职业周期类：浅灰底，暗示是次要分组 */
.chip-sub {
  background: #F4F6F8;
  border-color: #E2E6EA;
}

/* 空态 */
.empty {
  padding: 140rpx 0;
  text-align: center;
  color: #93A1AF;
  font-size: 26rpx;
}

/* 分割 */
.hr {
  height: 1rpx;
  background: #EDF0F4;
  margin: 24rpx 0;
}

/* 文本省略 */
.ell {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ell2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
