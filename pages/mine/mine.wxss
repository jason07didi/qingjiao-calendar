.page {
  background: #F4F6F8;
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* 用户卡 */
.user-card {
  background: #123B5B;
  color: #FFFFFF;
  padding: 36rpx 34rpx 32rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.avatar-box {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar {
  font-size: 58rpx;
  line-height: 1;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

.avatar-upload {
  margin-bottom: 18rpx;
  padding: 18rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #123B5B;
  background: #EAF1F7;
  border-radius: 14rpx;
}

.user-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.username {
  font-size: 34rpx;
  font-weight: 600;
}

/* ===== VIP 徽标（头像右侧、昵称旁边） ===== */
.name-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.name-row .username {
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vip-badge {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  height: 34rpx;
  padding: 0 12rpx 0 10rpx;
  margin-left: 12rpx;
  border-radius: 999rpx;
  position: relative;
  overflow: hidden;
}

.vip-gem {
  width: 10rpx;
  height: 10rpx;
  border-radius: 2rpx;
  transform: rotate(45deg);
  margin-right: 7rpx;
}

.vip-label {
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 1.5rpx;
  line-height: 1;
}

/* 未开通：灰色，完全静止，不抢注意力 */
.vip-badge.is-off {
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}
.vip-badge.is-off .vip-gem {
  background: rgba(255, 255, 255, 0.40);
}
.vip-badge.is-off .vip-label {
  color: rgba(255, 255, 255, 0.55);
}

/* 已开通：琥珀金渐变 + 循环流光 + 光晕呼吸 */
.vip-badge.is-on {
  background: linear-gradient(100deg, #FFE7A8 0%, #FFCB4F 38%, #FFE7A8 62%, #F3AE22 100%);
  background-size: 220% 100%;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  animation: vipFlow 3.4s linear infinite, vipGlow 2.8s ease-in-out infinite;
}
.vip-badge.is-on .vip-gem {
  background: #7A4E06;
  box-shadow: 0 0 6rpx rgba(255, 255, 255, 0.8);
}
.vip-badge.is-on .vip-label {
  color: #6B4408;
  text-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.55);
}

/* 流光条：从左侧扫到右侧，周期性跑一次 */
.vip-badge.is-on::after {
  content: '';
  position: absolute;
  top: -20%;
  left: -60%;
  width: 38%;
  height: 140%;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.9) 50%, rgba(255, 255, 255, 0) 100%);
  transform: skewX(-20deg);
  animation: vipShine 3.4s ease-in-out infinite;
}

@keyframes vipFlow {
  0% { background-position: 0% 0; }
  100% { background-position: 220% 0; }
}

@keyframes vipShine {
  0% { left: -60%; }
  52%, 100% { left: 130%; }
}

@keyframes vipGlow {
  0%, 100% { box-shadow: 0 2rpx 8rpx rgba(243, 174, 34, 0.30); }
  50% { box-shadow: 0 3rpx 20rpx rgba(243, 174, 34, 0.72); }
}

.bio {
  font-size: 23rpx;
  opacity: 0.72;
  margin-top: 8rpx;
}

.user-stats {
  width: 100%;
  display: flex;
  margin-top: 30rpx;
  background: rgba(255, 255, 255, 0.09);
  border-radius: 16rpx;
  padding: 20rpx 0;
}

.us-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.us-num {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
}

.us-lab {
  font-size: 21rpx;
  opacity: 0.68;
  margin-top: 2rpx;
}

/* 区块 */
.block {
  background: #FFFFFF;
  margin: 22rpx 26rpx 0;
  border-radius: 20rpx;
  padding: 26rpx;
  box-shadow: 0 2rpx 10rpx rgba(18, 59, 91, 0.04);
}

.block-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.block-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1B2733;
}

.block-act {
  font-size: 22rpx;
  color: #8B98A5;
}

.block-hint {
  font-size: 21rpx;
  color: #A7B2BE;
  margin-top: 8rpx;
}

/* 会员码入口在头像旁的 VIP 徽标上；「会员」与「提醒节点」两块已按用户要求移除 */

/* 学科选择 */
.dis-wrap {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.dis {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #5A6B7B;
  background: #F3F6F9;
  margin: 0 14rpx 14rpx 0;
}

.dis.on {
  background: #123B5B;
  color: #FFFFFF;
}

/* 菜单 */
.menu {
  background: #FFFFFF;
  margin: 22rpx 26rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(18, 59, 91, 0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 26rpx;
  border-bottom: 1rpx solid #F4F6F9;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 30rpx;
  margin-right: 16rpx;
}

.menu-text {
  flex: 1;
  font-size: 27rpx;
  color: #1B2733;
}

/* 菜单行右侧的计数徽标（如「我的收藏 N」） */
.menu-count {
  font-size: 22rpx;
  color: #FFFFFF;
  background: #2E6FA8;
  border-radius: 999rpx;
  padding: 2rpx 16rpx;
  margin-right: 14rpx;
  font-weight: 600;
}

.menu-arrow {
  color: #C6CFD8;
  font-size: 32rpx;
}

.footer {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  color: #B3BDC7;
  margin: 34rpx 0 10rpx;
  padding: 0 40rpx;
  text-align: center;
}

.meta-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #C6CFD8;
  margin-right: 10rpx;
  flex: 0 0 auto;
}

.meta-dot.on {
  background: #42C08A;
}

/* 头像弹窗 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(16, 28, 40, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.panel {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 34rpx 30rpx 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.panel-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1B2733;
}

.avatar-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.avatar-opt {
  width: 16.6%;
  text-align: center;
  font-size: 48rpx;
  line-height: 1.9;
}

.panel-cancel {
  margin-top: 20rpx;
  text-align: center;
  padding: 22rpx 0;
  font-size: 27rpx;
  color: #8B98A5;
  border-top: 1rpx solid #F0F3F6;
}

/* 个人条件 */
.cond-row {
  display: flex;
  align-items: center;
  padding: 18rpx 4rpx;
  border-bottom: 1rpx solid #F0F3F6;
}

.cond-row:last-child {
  border-bottom: none;
}

.cond-lab {
  width: 110rpx;
  font-size: 26rpx;
  color: #425260;
}

.cond-val {
  display: flex;
  align-items: center;
  flex: 1;
}

.cond-input {
  font-size: 27rpx;
  color: #1B2A38;
  min-height: 48rpx;
}

.cond-text {
  line-height: 48rpx;
}

.cond-ph {
  color: #B3BDC7;
}

.cond-unit {
  font-size: 24rpx;
  color: #93A1AF;
  margin-left: 10rpx;
}

.cond-arrow {
  margin-left: auto;
  color: #B3BDC7;
  font-size: 30rpx;
}

/* 下拉选择行 */
.pick-row {
  display: flex;
  align-items: center;
  padding: 22rpx 4rpx;
}

.pick-sel {
  display: flex;
  align-items: center;
  flex: 1;
}

/* 多选弹层 */
.fmask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(18, 30, 42, 0.45);
  z-index: 90;
}

.fpanel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
  padding: 34rpx 30rpx calc(40rpx + env(safe-area-inset-bottom));
}

.fp-head {
  display: flex;
  align-items: center;
}

.fp-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1B2A38;
}

.fp-reset {
  margin-left: auto;
  font-size: 26rpx;
  color: #5A8BB0;
}

.fp-hint {
  font-size: 22rpx;
  color: #9AA7B3;
  margin-top: 8rpx;
}

.fp-wrap {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.fp-chip {
  font-size: 26rpx;
  color: #425260;
  background: #F1F4F7;
  border-radius: 30rpx;
  padding: 12rpx 30rpx;
  margin: 0 16rpx 16rpx 0;
  border: 1rpx solid #F1F4F7;
}

.fp-chip.on {
  color: #123B5B;
  background: #E3ECF4;
  border-color: #123B5B;
  font-weight: 600;
}

.fp-done {
  margin-top: 26rpx;
  background: #123B5B;
  color: #FFFFFF;
  text-align: center;
  font-size: 30rpx;
  border-radius: 40rpx;
  padding: 20rpx 0;
}
