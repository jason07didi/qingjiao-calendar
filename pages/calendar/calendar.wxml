<view class="page">

  <view class="cal-head">
    <view class="nav" bindtap="prevMonth">‹</view>
    <view class="month-wrap" bindtap="goToday">
      <text class="month">{{label}}</text>
      <text class="month-sub">今天 {{todayLabel}} · 本月 {{monthCount}} 项截止</text>
    </view>
    <view class="nav" bindtap="nextMonth">›</view>
  </view>

  <view class="filter-hint" wx:if="{{filterHint}}">{{filterHint}}</view>

  <view class="week-row">
    <text class="week-cell" wx:for="{{weekdays}}" wx:key="*this">{{item}}</text>
  </view>

  <view class="grid">
    <view
      class="cell {{item.inMonth ? '' : 'out'}} {{item.dateStr === selected ? 'sel' : ''}} {{item.isToday ? 'today' : ''}}"
      wx:for="{{cells}}"
      wx:key="index"
      data-ds="{{item.dateStr}}"
      bindtap="onPick"
    >
      <text class="cell-day">{{item.day}}</text>
      <view class="badge lv-{{item.level}}" wx:if="{{item.count > 0}}">{{item.count > 99 ? '99+' : item.count}}</view>
    </view>
  </view>

  <view class="legend">
    <view class="lg"><view class="lg-dot lv-urgent"></view><text>≤3天</text></view>
    <view class="lg"><view class="lg-dot lv-soon"></view><text>≤7天</text></view>
    <view class="lg"><view class="lg-dot lv-normal"></view><text>≤30天</text></view>
    <view class="lg"><view class="lg-dot lv-later"></view><text>更远期</text></view>
    <text class="lg-note">数字＝当天截止项数</text>
  </view>

  <view class="legend">
    <view class="lg"><view class="lg-dot lv-urgent"></view><text>≤3天</text></view>
    <view class="lg"><view class="lg-dot lv-soon"></view><text>≤7天</text></view>
    <view class="lg"><view class="lg-dot lv-normal"></view><text>≤30天</text></view>
    <view class="lg"><view class="lg-dot lv-later"></view><text>更远期</text></view>
    <text class="lg-note">数字＝当天截止项数</text>
  </view>

  <view class="day-panel">
    <view class="day-head">
      <text class="day-title" wx:if="{{selectedLabel}}">{{selectedLabel}} 截止</text>
      <text class="day-title" wx:else>本月暂无截止事项</text>
      <text class="day-count day-go" wx:if="{{dayList.length > 0}}" bindtap="openDayInList">{{dayList.length}} 项 · 看全部 ›</text>
    </view>

    <view
      class="day-item"
      wx:for="{{dayList}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <view class="di-left">
        <text class="tag tag-{{item.type}}">{{item.typeName}}</text>
      </view>
      <view class="di-body">
        <view class="di-title ell2">{{item.title}}</view>
        <view class="di-org ell">{{item.org}}</view>
      </view>
      <text class="di-arrow">›</text>
    </view>

    <view class="day-empty" wx:if="{{dayList.length === 0 && selectedLabel}}">
      这一天没有截止事项
    </view>
  </view>

</view>
