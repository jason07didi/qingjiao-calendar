.page {
  background: #F4F6F8;
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* 月份头 */
.cal-head {
  background: #123B5B;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 40rpx 30rpx;
}

.nav {
  width: 70rpx;
  height: 70rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 46rpx;
  opacity: 0.75;
}

.month-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.month {
  font-size: 36rpx;
  font-weight: 600;
}

.month-sub {
  font-size: 21rpx;
  opacity: 0.65;
  margin-top: 4rpx;
}

/* 星期 */
.week-row {
  display: flex;
  background: #FFFFFF;
  padding: 18rpx 12rpx 10rpx;
}

/* 筛选同步提示：告诉用户日历已按「我的」偏好过滤 */
.filter-hint {
  background: #EAF1F7;
  color: #4A6B86;
  font-size: 22rpx;
  text-align: center;
  padding: 14rpx 24rpx;
  margin: 0;
}

.week-cell {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #93A1AF;
}

/* 图例：解释日历里的颜色紧急度与数字含义，做到「清晰明确」 */
.legend {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  background: #FFFFFF;
  padding: 16rpx 20rpx 20rpx;
  font-size: 20rpx;
  color: #6B7884;
}

.lg {
  display: flex;
  align-items: center;
  margin: 0 14rpx;
}

.lg-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 7rpx;
}

.lg-dot.lv-urgent { background: #E54D42; }
.lg-dot.lv-soon   { background: #F2820A; }
.lg-dot.lv-normal { background: #2E6DB4; }
.lg-dot.lv-later  { background: #B0BAC4; }

.lg-note {
  width: 100%;
  text-align: center;
  margin-top: 10rpx;
  font-size: 19rpx;
  color: #A7B2BE;
}

